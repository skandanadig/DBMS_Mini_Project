# Copy to `.env` in the repo root. This single file is used by docker compose
# AND by the web app / tests (web/lib/env.ts loads ../.env at runtime).
# Never commit real .env files.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=skillmatch_app
MYSQL_PASSWORD=change_me_app
MYSQL_HOST=127.0.0.1
# Host port for the Docker MySQL (3307 avoids clashing with a local MySQL on 3306)
MYSQL_PORT=3307
MYSQL_DATABASE=skillmatch_db

# ---------- Neo4j ----------
# Neo4j requires a password of at least 8 characters
NEO4J_PASSWORD=change_me_neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Web app ----------
# Signs session cookies. Must be at least 32 characters - the app refuses to
# start with this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_hex_chars
